// Wind-swaying, alpha-masked grass cards. One batched geometry holds every
// card; the sway phase derives from world position, so cards de-sync without
// per-instance data. The engine has no time uniform `time`, `wind_strength`,
// and `wind_dir` are parameters written from Dart each frame (the seam the
// Phase-5 WindState resource drives).
//
// Two scales of variation give the field life. Per card, a baked vertex tint
// and a root-to-tip gradient. Across the clearing, a slow simplex field
// drifts regions between short deep-green and taller dry-yellow, so the
// carpet reads as terrain rather than one uniform texture.
material {
  name: "grass_sway",
  shading_model: lit,
  blending: opaque,
  culling: back,
  parameters: [
    { type: sampler2d, name: blade_texture, hint: default_white },
    { type: float, name: time, default: 0.0 },
    { type: float, name: wind_strength, hint: range(0, 2, 0.01), default: 0.35 },
    { type: vec2, name: wind_dir, default: [0.8, 0.6] },
    { type: float, name: sway_scale, hint: range(0.01, 2, 0.01), default: 0.3 },
    // Fast flutter riding the slow gust.
    { type: float, name: wind_turbulence, hint: range(0, 1.5, 0.01), default: 0.25 },
    // Signed static lean downwind, so wind reads as blowing from somewhere
    // rather than only shimmering in place.
    { type: float, name: wind_lean, hint: range(-1, 1, 0.01), default: 0.12 },
    // The macro field: a lower scale means broader patches.
    { type: float, name: macro_scale, hint: range(0.01, 1, 0.01), default: 0.12 },
    { type: float, name: height_low, hint: range(0.3, 1.2, 0.01), default: 0.8 },
    { type: float, name: height_high, hint: range(1, 2.5, 0.01), default: 1.35 },
    // Multiplier tints, so the blade texture and the baked card tint still
    // carry the base look. Root is shaded, tip catches light.
    { type: vec4, name: root_color, default: [0.55, 0.62, 0.45, 1.0] },
    { type: vec4, name: tip_color, default: [1.15, 1.12, 0.95, 1.0] },
    // The macro field's two ends: deep green and dry yellow.
    { type: vec4, name: short_color, default: [0.78, 1.00, 0.72, 1.0] },
    { type: vec4, name: tall_color, default: [1.30, 1.12, 0.62, 1.0] },
  ],
  varyings: [
    { type: float, name: blade_h },
    { type: float, name: macro },
  ],
}
vertex {
  #include <noise.glsl>

  void Vertex(inout VertexInputs vertex) {
    // Uniform parameters are members of the generated material_params block;
    // only samplers are bare identifiers.
    float time = material_params.time;
    vec2 wind = material_params.wind_dir;
    // Roots pinned, tips free: uv.y is 1 at the root, 0 at the tip.
    float bend = 1.0 - vertex.uv.y;

    // Sampled before the sway displaces the card, so a blade keeps its
    // region's look instead of shifting palette as it waves.
    macro = smoothstep(
        0.2, 0.8,
        NoiseSimplex2(vertex.world_position.xz * material_params.macro_scale, 23)
            * 0.5 + 0.5);
    float heightScale =
        mix(material_params.height_low, material_params.height_high, macro);

    vec2 phase =
        vertex.world_position.xz * material_params.sway_scale + wind * time * 0.9;
    // Slow traveling gust plus a small fast flutter, both from the shared
    // FastNoiseLite port so a Dart consumer can match the field exactly.
    float gust = NoiseSimplex2(phase, 7);
    float flutter = NoiseSimplex2(phase * 3.1 + vec2(0.0, time * 2.3), 13)
        * material_params.wind_turbulence;
    // Taller patches sway and lean further.
    float amount = (gust + flutter) * material_params.wind_strength
        * bend * bend * heightScale;
    float lean = material_params.wind_lean * bend * bend * heightScale;
    vertex.world_position.xz += wind * (amount + lean);
    // Roots sit at world y = 0, so scaling y stretches a blade from its own
    // root without lifting it off the ground.
    vertex.world_position.y *= heightScale;

    blade_h = bend;
  }
}
fragment {
  void Surface(inout MaterialInputs material) {
    vec4 blade = texture(blade_texture, GetUV0());
    if (blade.a < 0.5) {
      discard;
    }
    // The card carries its tint in the vertex color (per-card variation baked
    // at batch time); the texture contributes the blade silhouette + shading.
    vec3 col = blade.rgb * GetVertexColor().rgb;
    // Shaded at the root, brighter at the tip.
    col *= mix(material_params.root_color.rgb, material_params.tip_color.rgb,
               blade_h);
    // Then the region's palette: deep green through dry yellow.
    col *= mix(material_params.short_color.rgb, material_params.tall_color.rgb,
               macro);
    material.base_color = vec4(col, 1.0);
    material.roughness = 1.0;
    material.metallic = 0.0;
  }
}
