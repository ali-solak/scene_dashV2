// Wind swept grass.
material {
  name: "grass_sway",
  shading_model: lit,
  blending: opaque,
  // Double sided geometry.
  culling: back,
  parameters: [
    { type: float, name: time, default: 0.0 },
    { type: float, name: wind_strength, hint: range(0, 2, 0.01), default: 0.35 },
    { type: vec2, name: wind_dir, default: [0.8, 0.6] },
    { type: float, name: sway_scale, hint: range(0.01, 2, 0.01), default: 0.3 },
    // Fast flutter riding the slow gust.
    { type: float, name: wind_turbulence, hint: range(0, 1.5, 0.01), default: 0.25 },
    // Static downwind lean.
    { type: float, name: wind_lean, hint: range(-1, 1, 0.01), default: 0.12 },
    // Lower values create broader patches.
    { type: float, name: macro_scale, hint: range(0.01, 1, 0.01), default: 0.12 },
    // Macro height range.
    { type: float, name: height_low, hint: range(0.3, 1.2, 0.01), default: 0.70 },
    { type: float, name: height_high, hint: range(1, 2.5, 0.01), default: 1.65 },
    // Multiplier tints over the baked per-blade tint. Root is shaded, tip
    // catches light.
    { type: vec4, name: root_color, default: [0.55, 0.62, 0.45, 1.0] },
    { type: vec4, name: tip_color, default: [1.15, 1.12, 0.95, 1.0] },
    // The macro field's two ends: deep green and dry yellow.
    { type: vec4, name: short_color, default: [0.78, 1.00, 0.72, 1.0] },
    { type: vec4, name: tall_color, default: [1.30, 1.12, 0.62, 1.0] },
  ],
  varyings: [
    { type: float, name: blade_h },
    { type: float, name: macro },
  ],
}
vertex {
  #include <noise.glsl>

  void Vertex(inout VertexInputs vertex) {
    // Material values.
    float time = material_params.time;
    vec2 wind = material_params.wind_dir;
    // Bend blade tips.
    float bend = step(0.001, vertex.position.y);

    // Sample the color region.
    macro = smoothstep(
        0.2, 0.8,
        NoiseSimplex2(vertex.world_position.xz * material_params.macro_scale, 23)
            * 0.5 + 0.5);
    float heightScale =
        mix(material_params.height_low, material_params.height_high, macro);

    vec2 phase =
        vertex.world_position.xz * material_params.sway_scale + wind * time * 0.9;
    // Gust and flutter.
    float gust = NoiseSimplex2(phase, 7);
    float flutter = NoiseSimplex2(phase * 3.1 + vec2(0.0, time * 2.3), 13)
        * material_params.wind_turbulence;
    // Taller patches sway and lean further.
    float amount = (gust + flutter) * material_params.wind_strength
        * bend * bend * heightScale;
    float lean = material_params.wind_lean * bend * bend * heightScale;
    vertex.world_position.xz += wind * (amount + lean);
    // Stretch from the root.
    vertex.world_position.y *= heightScale;

    blade_h = bend;
  }
}
fragment {
  void Surface(inout MaterialInputs material) {
    // Olive blades with dark roots.
    vec3 blade =
        vec3(0.784, 0.902, 0.549) * mix(0.55, 1.0, blade_h);
    vec3 col = blade * GetVertexColor().rgb;
    // Shaded at the root, brighter at the tip.
    col *= mix(material_params.root_color.rgb, material_params.tip_color.rgb,
               blade_h);
    // Then the region's palette: deep green through dry yellow.
    col *= mix(material_params.short_color.rgb, material_params.tall_color.rgb,
               macro);
    material.base_color = vec4(col, 1.0);
    material.roughness = 1.0;
    material.metallic = 0.0;
  }
}
